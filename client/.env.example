# ERNIE Pod Client — fill in and rename to .env
#
# POD_URL: public proxy URL of your RunPod Pod, format:
#   https://<pod_id>-<port>.proxy.runpod.net
# You'll find this on the Pod's "Connect" panel after starting the Pod.
POD_URL=https://xxxxxxxxxxx-8000.proxy.runpod.net

# Optional: only needed if you set POD_API_KEY on the server (start.sh).
# Leave blank if your Pod has no auth (URL is the secret).
POD_API_KEY=
